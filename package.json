{
    "name": "@stackcraftmx/calcita",
    "version": "0.31.0",
    "description": "Componentes y utilidades de React con MUI para arrancar proyectos rápido: tabla de servidor, diálogos, avisos, descargas, formularios, formatos y reportes en Excel.",
    "license": "FSL-1.1-MIT",
    "author": "calcifux",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/StackCraftMx/calcita.git"
    },
    "homepage": "https://github.com/StackCraftMx/calcita#readme",
    "bugs": "https://github.com/StackCraftMx/calcita/issues",
    "keywords": [
        "react",
        "mui",
        "material-ui",
        "components",
        "data-grid",
        "server-table",
        "formik",
        "xstate",
        "excel",
        "i18n",
        "upload",
        "filepond",
        "money",
        "react-hook-form",
        "date-picker",
        "wizard",
        "nextjs"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "packageManager": "pnpm@11.5.1",
    "engines": {
        "node": ">=22"
    },
    "volta": {
        "node": "22.22.2",
        "pnpm": "11.5.1"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "cli",
        "!cli/**/*.test.js"
    ],
    "bin": {
        "calcita": "./cli/calcita.js"
    },
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        },
        "./table": {
            "types": "./dist/types/table.d.ts",
            "import": "./dist/table.js"
        },
        "./forms": {
            "types": "./dist/types/forms.d.ts",
            "import": "./dist/forms.js"
        },
        "./charts": {
            "types": "./dist/types/charts.d.ts",
            "import": "./dist/charts.js"
        },
        "./timeline": {
            "types": "./dist/types/timeline.d.ts",
            "import": "./dist/timeline.js"
        },
        "./excel": {
            "types": "./dist/types/excel.d.ts",
            "import": "./dist/excel.js"
        },
        "./react-router": {
            "types": "./dist/types/react-router.d.ts",
            "import": "./dist/react-router.js"
        },
        "./i18next": {
            "types": "./dist/types/i18next.d.ts",
            "import": "./dist/i18next.js"
        },
        "./laravel": {
            "types": "./dist/types/laravel.d.ts",
            "import": "./dist/laravel.js"
        },
        "./money": {
            "types": "./dist/types/money.d.ts",
            "import": "./dist/money.js"
        },
        "./filepond": {
            "types": "./dist/types/filepond.d.ts",
            "import": "./dist/filepond.js"
        },
        "./react-hook-form": {
            "types": "./dist/types/react-hook-form.d.ts",
            "import": "./dist/react-hook-form.js"
        },
        "./date-pickers": {
            "types": "./dist/types/date-pickers.d.ts",
            "import": "./dist/date-pickers.js"
        },
        "./next": {
            "types": "./dist/types/next.d.ts",
            "import": "./dist/next.js"
        },
        "./passkeys": {
            "types": "./dist/types/passkeys.d.ts",
            "import": "./dist/passkeys.js"
        },
        "./account": {
            "types": "./dist/types/account.d.ts",
            "import": "./dist/account.js"
        },
        "./account-demo": {
            "types": "./dist/types/account-demo.d.ts",
            "import": "./dist/account-demo.js"
        },
        "./maps": {
            "types": "./dist/types/maps.d.ts",
            "import": "./dist/maps.js"
        },
        "./calendar": {
            "types": "./dist/types/calendar.d.ts",
            "import": "./dist/calendar.js"
        },
        "./kanban": {
            "types": "./dist/types/kanban.d.ts",
            "import": "./dist/kanban.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prepublishOnly": "pnpm run check",
        "build": "vite build --outDir .dist-next && node scripts/swapBuild.js && pnpm run types",
        "types": "tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json && node scripts/stripStyleImportsFromTypes.js",
        "test": "node --import ./testing/registerAliasHooks.js --test \"src/**/*.test.js\" \"cli/**/*.test.js\"",
        "check": "pnpm test && pnpm run build && node testing/smokeRender.js && node testing/cliProjects.js && tsc -p testing/typescriptConsumer/tsconfig.json && pnpm --filter @stackcraftmx/calcita-examples run check",
        "examples": "pnpm run build && pnpm --filter @stackcraftmx/calcita-examples run dev",
        "tunnel:start": "bash scripts/tunnel.sh start",
        "tunnel:stop": "bash scripts/tunnel.sh stop",
        "tunnel:status": "bash scripts/tunnel.sh status"
    },
    "dependencies": {
        "uuid": "14.0.2"
    },
