// Revisa que el TypeScript de los ejemplos del catálogo compile: es el que se copia con «Ver código». No genera nada.
// vite/client: los ejemplos leen import.meta.env (la dirección del API), como un proyecto de Vite.
{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "types": ["vite/client"]
    },
    "include": ["src/modules/catalog/demos/**/*.tsx", "src/modules/catalog/demos/**/*.ts"]
}
